[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[internationalization]

locale/fallback="en"

[layer_names]

2d_physics/layer_1="terrain"
2d_physics/layer_2="vehicle"
2d_physics/layer_3="props"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=6
2d/default_gravity=480.0
2d/default_linear_damp=0.0
2d/default_angular_damp=0.0
2d/solver/solver_iterations=16

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.058, 0.09, 0.16, 1)
2d/snap/snap_2d_transforms_to_pixel=false
anti_aliasing/quality/msaa_2d=0
textures/vram_compression/import_etc2_astc=true
