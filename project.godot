; Engine configuration file.
; UZ Drive: Hill Adventure — Godot 4.7 project.

config_version=5

[application]

config/name="UZ Drive: Hill Adventure"
config/description="2D hill-climb driving adventure with 50+ collectible vehicles."
config/version="1.0.0"
run/main_scene="res://src/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/branding/icon.svg"
boot_splash/bg_color=Color(0.058, 0.09, 0.16, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/branding/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
config/quit_on_go_back=false
run/max_fps=60
run/low_processor_mode=false

[autoload]

Events="*res://src/autoload/events.gd"
DB="*res://src/autoload/db.gd"
Save="*res://src/autoload/save_manager.gd"
Profile="*res://src/autoload/profile.gd"
Loc="*res://src/autoload/loc.gd"
Economy="*res://src/autoload/economy.gd"
Progress="*res://src/autoload/progression.gd"
Audio="*res://src/autoload/audio_manager.gd"
Services="*res://src/autoload/services.gd"
UI="*res://src/autoload/ui.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[gui]

theme/custom="res://assets/ui/theme.tres"
common/drop_mouse_on_gui_input_disabled=true
theme/default_font_antialiasing=1
theme/default_font_hinting=1

[input]

gas={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194321,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
